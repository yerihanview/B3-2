# B3-2 AI Git Helper 환경 설정 예시
# 본 파일을 .env 로 복사한 뒤 실제 API 키와 Base URL을 설정하세요.
# 주의: 실제 키가 포함된 .env 파일은 .gitignore에 의해 절대 Git에 커밋되지 않습니다.

# 1. OpenAI 공식 API 사용 시:
# OPENAI_API_KEY=sk-your-openai-api-key-here

# 2. Codyssey Public API (copa.codyssey.kr) 사용 시:
OPENAI_API_KEY=sk-your-codyssey-key-here
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
# 추천 모델 (최소 토큰 비용: gemini-3-flash / 기본 미니: gpt-5.4-mini / 고지능: claude-sonnet-4)
AI_MODEL=gemini-3-flash

